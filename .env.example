# Moriarty — exemplo de variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o arquivo real.

# Obrigatório: segredo usado para assinar cookies de sessão (mínimo 32 caracteres aleatórios).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres

# Banco de dados PostgreSQL (Supabase, Neon, Railway, VPS...).
# - Em produção no Supabase use a connection string do "Session Pooler" (porta 5432/6543).
# - Localmente, um Postgres em Docker serve: postgresql://postgres:postgres@localhost:5432/moriarty
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moriarty

# Fuso horário usado para agrupar datas das sessões de estudo.
APP_TIMEZONE=America/Sao_Paulo

# Envio de e-mail (Resend). Sem RESEND_API_KEY o app funciona normalmente e a
# recuperação de senha registra o token no log do servidor (modo manual).
# - Crie a chave em https://resend.com/api-keys
# - A conta gratuita só envia para o próprio e-mail do titular; para outros
#   destinatários, verifique um domínio e use-o em EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=Moriarty <onboarding@resend.dev>

# Base pública do app (usada nos links dos e-mails, ex.: link de recuperação).
APP_URL=https://moriarty-alpha.vercel.app

# Armazenamento dos arquivos enviados pelo usuário (Supabase Storage).
# Em produção é obrigatório: o disco da Vercel é efêmero e somente leitura, então
# os arquivos enviados sumiriam (ou o upload falharia) a cada novo deploy.
# - Crie um bucket PRIVADO em https://supabase.com/dashboard (ex.: "moriarty")
# - Copie a URL do projeto e a service_role key em Settings → API
# - A service_role key é usada APENAS no servidor; nunca a exponha no navegador.
# Sem estas variáveis o app usa o disco local (apenas para desenvolvimento).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=moriarty

# Opcional: provedor de IA (Gemini). Se ausente, o Moriarty funciona 100%
# com o motor determinístico local (cronograma e revisões).
# A chave é usada APENAS no servidor, nunca chega ao navegador.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gemini-3.5-flash

# Opcional: limite diário de chamadas de IA por usuário (padrão 20).
AI_DAILY_LIMIT=20
